{# begin {templatelocation} #}

		<table width="100%" border="0" cellspacing="1" cellpadding="4" class="">
			{user_name}
			{moods}
			{code}
            <tr>
                <td class="pluginCellSubTitle">&nbsp;{LANG_SUBJECT}:</td>
                <td class="pluginCellText pluginCellFill">
                    <input type="text" name="subject" value="{subject}" id="input1" tabindex="5" size="80"{xhtml}>
                </td>
            </tr>
            <tr>
                <td class="pluginCellSubTitle" style="vertical-align:top;padding-top:10px;">
                    {smilies}
                </td>
                <td class="pluginCellText pluginCellFill" style="padding-left: 5px;">
                    <div class="forum-visual-editor-shell">
                        <div id="forum-visual-editor" class="forum-visual-editor" contenteditable="true" role="textbox" aria-multiline="true" data-render-url="{editor_render_url}">{editor_html}</div>
                        <textarea name="comment" id="forum-editor-source" hidden>{post_message}</textarea>
                        <textarea name="forum_media_transport" id="forum-media-transport" hidden></textarea>
                        <input type="hidden" name="forum_editor_html" id="forum-editor-html" value="">
                        <input type="hidden" name="forum_editor_dirty" id="forum-editor-dirty" value="0">
                    </div>
                </td>
            </tr>
            {captcha}
            {options}
            {gl_topics}
            <tr>
                <td class="pluginCellSubTitle" style="padding:15px 5px 15px 10px; vertical-align:center;">{LANG_SUBMIT}</td>
                <td class="pluginCellText pluginCellFill alignright">
                    <table border="0" cellspacing="0" cellpadding="0" style="float:right;">
                        <tr>
                            <td><input type="submit" name="submitmode" value="{LANG_PREVIEW}" tabindex="7"{xhtml}></td>
                            <td style="padding-left:6px;padding-right:6px;">
                                <input type="submit" name="submitmode" value="{LANG_SUBMIT}" tabindex="8" class="g-recaptcha"{!if invisible_recaptcha}{invisible_recaptcha}{!endif}{xhtml}>
                                <input type="hidden" name="submitmode" value="{LANG_SUBMIT}"{xhtml}> {# Needed for Invisible reCaptcha Error message #}
                            </td>
                            <td style="padding-left:6px;padding-right:6px;"><input type="submit" name="submitmode" value="{LANG_CANCEL}" tabindex="9"{xhtml}></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

<!-- BEGIN submissionform_membertop -->
			<tr>
				<td class="pluginCellSubTitle" style="width:110px; white-space:nowrap;">&nbsp;{LANG_NAME}</td>
				<td class="pluginCellText pluginCellFill">{username}{!if aname}: <input id="form-forum-username" placeholder="" type="text" name="aname" value="{aname}"  maxlength="50" class="uk-form-width-medium"{xhtml}>{!endif}</td>
			</tr>
<!-- END submissionform_membertop -->

<!-- BEGIN submissionform_anontop -->
			<tr>
				<td colspan="2" class="pluginCellSubTitle" style="width:120px">&nbsp;<b>{post_message}</b></td>
			</tr>
			<tr>
				<td class="pluginCellSubTitle" style="width:110px">&nbsp;{LANG_NAME}</td>
				<td class="pluginCellText pluginCellFill"><input type="text" name="aname" value="{name}" size="40" maxlength="50" tabindex="1"{xhtml}>&nbsp;&nbsp;</td>
			</tr>
<!-- END submissionform_anontop -->        

<!-- BEGIN submissionform_moods -->
		<tr>
			<td class="pluginCellSubTitle">&nbsp;{LANG_MOOD}</td>
            <td class="pluginCellText pluginCellFill">
                <select name="mood" style="width:150px; text-indent: 0px;" tabindex="2">
                	{moodoptions}
                </select>
            </td>
        </tr>
<!-- END submissionform_moods -->
        
<!-- BEGIN submissionform_code -->
<div class="forum-visual-toolbar" role="toolbar" aria-label="Editor">
    <button type="button" class="button uk-button" data-forum-command="bold" title="{LANG_EDITOR_BOLD}" aria-label="{LANG_EDITOR_BOLD}"><strong>B</strong></button>
    <button type="button" class="button uk-button" data-forum-command="italic" title="{LANG_EDITOR_ITALIC}" aria-label="{LANG_EDITOR_ITALIC}"><em>I</em></button>
    <button type="button" class="button uk-button" data-forum-command="insertUnorderedList" title="{LANG_EDITOR_LIST}" aria-label="{LANG_EDITOR_LIST}">• List</button>
    <button type="button" class="button uk-button" data-forum-command="insertOrderedList" title="{LANG_EDITOR_OLIST}" aria-label="{LANG_EDITOR_OLIST}">1. List</button>
    <button type="button" class="button uk-button" data-forum-command="quote" title="{LANG_EDITOR_QUOTE}" aria-label="{LANG_EDITOR_QUOTE}">“ ”</button>
    <button type="button" class="button uk-button" data-forum-command="link" title="{LANG_EDITOR_LINK}" aria-label="{LANG_EDITOR_LINK}">Link</button>
    <button type="button" class="button uk-button" data-forum-command="code" title="{LANG_EDITOR_CODE}" aria-label="{LANG_EDITOR_CODE}">&lt;/&gt;</button>
    <span class="forum-media-toolbar">{mediagallery_picker}</span>
</div>
<!-- END submissionform_code -->

<!-- BEGIN submissionform_smilies -->
{smilies}
<!-- END submissionform_smilies -->

<!-- BEGIN submissionform_options -->
            <tr>
                <td class="pluginCellSubTitle">&nbsp;{LANG_OPTIONS}</td>
                <td class="pluginCellText pluginCellFill">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                        	{option}
                        </tr>
                    </table>
                </td>
            </tr>

<!-- END submissionform_options -->

<!-- BEGIN submissionform_option -->
<td style="width:20%;">
	<label for="{option_name}">{LANG_OPTION}</label><br{xhtml}>
	<input type="checkbox" name="{option_name}" id="{option_name}" {option_checked} value="1"{xhtml}>
	{option_extra}
</td>
<!-- END submissionform_option -->

<!-- BEGIN submissionform_gl_topics -->
<tr>
    <td class="pluginCellSubTitle">&nbsp;{LANG_TOPIC}:</td>
    <td class="pluginCellText pluginCellFill">
        {topic_selection}
        {LANG_GL_TOPICS_DESC}
    </td>
</tr>
<!-- END submissionform_gl_topics -->

{# end {templatelocation} #}