{# begin {templatelocation} #}

<div class="uk-alert uk-alert-warning forum-alert forum-alert-warning" role="alert">
	<h3 class="uk-panel-title forum-alert-title">{alert_title}</h3>
	<p class="forum-alert-message">{alert_message}</p>
	<p class="forum-alert-prompt">{prompt}</p>
</div>

{# end {templatelocation} #}