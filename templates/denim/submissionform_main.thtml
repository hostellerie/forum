{# begin {templatelocation} #}

{user_name}
<div class="uk-form-row">
	<label class="uk-form-label" for="form-forum-subject">{LANG_SUBJECT}</label>
	<div class="uk-form-controls">
		<input id="form-forum-subject" type="text" placeholder="" class="uk-form-width-large" name="subject" value="{subject}" maxlength="255"{xhtml}>
	</div>
</div>
{code}
{smilies}
<div class="forum-editor-format" aria-label="Post source format">{editor_mode_note}</div>
<div class="uk-form-row forum-editor-row">
	<div class="uk-form-controls forum-visual-editor-shell">
		<div id="forum-visual-editor" class="forum-visual-editor" contenteditable="true" role="textbox" aria-multiline="true" data-render-url="{editor_render_url}">{editor_html}</div>
		<textarea name="comment" id="forum-editor-source" hidden>{post_message}</textarea>
		<textarea name="forum_media_transport" id="forum-media-transport" hidden></textarea>
		<input type="hidden" name="forum_editor_html" id="forum-editor-html" value="">
		<input type="hidden" name="forum_editor_dirty" id="forum-editor-dirty" value="0">
	</div>
</div>
{moods}
{options}
<div class="uk-form-row uk-align-right">
	<div class="uk-form-controls">
		<button class="uk-button" type="submit" name="preview" value="{LANG_PREVIEW}">{LANG_PREVIEW}</button>
		<button class="uk-button" type="submit" name="submit" value="{LANG_SUBMIT}">{LANG_SUBMIT}</button>
		<button class="uk-button" type="submit" name="submit" value="{LANG_CANCEL}">{LANG_CANCEL}</button>
	</div>
</div>
{captcha}

<!-- BEGIN submissionform_membertop -->
<p><b>{post_message}</b></p>

<div class="uk-form-row">
	<label class="uk-form-label" for="form-forum-username">{LANG_NAME}</label>
	<div class="uk-form-controls">
		<input id="form-forum-username" placeholder="" type="hidden" name="name" size="35" value="{xusername}"{xhtml}>{username}
	</div>	
</div>
<!-- END submissionform_membertop -->

<!-- BEGIN submissionform_anontop -->
<p><b>{post_message}</b></p>

<div class="uk-form-row">
	<label class="uk-form-label" for="form-forum-username">{LANG_NAME}</label>
	<div class="uk-form-controls">
		<input id="form-forum-username" placeholder="" type="text" name="aname" value="{name}"  maxlength="50" class="uk-form-width-medium"{xhtml}>
	</div>	
</div>
<!-- END submissionform_anontop -->

<!-- BEGIN submissionform_moods -->
<div class="uk-form-row forum-mood-field">
	<div class="uk-form-label">{LANG_MOOD}</div>
	<div class="uk-form-controls">
		<div class="forum-mood-grid" role="radiogroup" aria-label="{LANG_MOOD}">
			{moodoptions}
		</div>
	</div>
</div>
<!-- END submissionform_moods -->
        
<!-- BEGIN submissionform_code -->
<div class="forum-visual-toolbar" role="toolbar" aria-label="Editor">
    <button type="button" class="button uk-button" data-forum-command="bold" title="{LANG_EDITOR_BOLD}" aria-label="{LANG_EDITOR_BOLD}"><strong>B</strong></button>
    <button type="button" class="button uk-button" data-forum-command="italic" title="{LANG_EDITOR_ITALIC}" aria-label="{LANG_EDITOR_ITALIC}"><em>I</em></button>
    <button type="button" class="button uk-button" data-forum-command="insertUnorderedList" title="{LANG_EDITOR_LIST}" aria-label="{LANG_EDITOR_LIST}">• List</button>
    <button type="button" class="button uk-button" data-forum-command="insertOrderedList" title="{LANG_EDITOR_OLIST}" aria-label="{LANG_EDITOR_OLIST}">1. List</button>
    <button type="button" class="button uk-button" data-forum-command="quote" title="{LANG_EDITOR_QUOTE}" aria-label="{LANG_EDITOR_QUOTE}">“ ”</button>
    <button type="button" class="button uk-button" data-forum-command="link" title="{LANG_EDITOR_LINK}" aria-label="{LANG_EDITOR_LINK}">Link</button>
    <button type="button" class="button uk-button" data-forum-command="code" title="{LANG_EDITOR_CODE}" aria-label="{LANG_EDITOR_CODE}">&lt;/&gt;</button>
    <span class="forum-media-toolbar">{mediagallery_picker}</span>
</div>
<!-- END submissionform_code -->

<!-- BEGIN submissionform_smilies -->
<div class="uk-form-row forum-smilies-row">
	<div class="uk-form-controls">
		{smilies}
	</div>	
</div>
<!-- END submissionform_smilies -->

<!-- BEGIN submissionform_options -->
<div class="uk-form-row">
	<label class="uk-form-label" for="form-forum-options">{LANG_OPTIONS}</label>
	<div class="uk-form-controls">
			{option}
	</div>
</div>
<!-- END submissionform_options -->

<!-- BEGIN submissionform_option -->
	<label class="uk-form-label" for="form-forum-{option_name}">
		<input type="checkbox" name="{option_name}" id="form-forum-{option_name}" {option_checked} value="1"{xhtml}>
		{option_extra}
		{LANG_OPTION}
	</label>
<!-- END submissionform_option -->


{# end {templatelocation} #}
